## Small helper functions.


func _ready() -> void:
	var add_result: int = add(2, 3)
	var parity_result: String = parity(add_result)
	print(str(add_result) + " is " + parity_result)


## Returns the sum of a and b.
func add(a: int, b: int) -> int:
	return a + b


## Describes whether n is even or odd.
func parity(n: int) -> String:
	if n % 2 == 0:
		return "even"
	else:
		return "odd"
