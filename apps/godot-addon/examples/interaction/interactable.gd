# Generated by Coding Studio from the visual script "Interactable".
# Edit the graph in Coding Studio; changes made here are overwritten on the next export.
extends Area2D
## Add to an Area2D with a CollisionShape2D. Bodies in the "player" group can interact with ui_accept.

signal interacted

@export var prompt: String = "Press Enter to interact"

var player_inside: bool = false


func _ready() -> void:
	connect("body_entered", _on_body_entered)
	connect("body_exited", _on_body_exited)


func _unhandled_input(event: InputEvent) -> void:
	if player_inside and event.is_action_pressed("ui_accept"):
		interacted.emit()
		print("Interacted!")


func _on_body_entered(body: Node2D) -> void:
	if body.is_in_group("player"):
		player_inside = true
		print(prompt)


func _on_body_exited(body: Node2D) -> void:
	if body.is_in_group("player"):
		player_inside = false
