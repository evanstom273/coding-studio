@tool
extends VBoxContainer
## Main-screen editor for Coding Studio project files (.vproj.json).
##
## The document is kept as a Dictionary in the same format as the web editor. Every change is
## sent to the companion service's /apply endpoint, which runs the same validated, atomic edit
## operations as the web editor and returns the new document; the graph view is then redrawn.

const CompanionClient := preload("res://addons/coding_studio/companion_client.gd")
const GENERATED_HEADER := "# Generated by Coding Studio"
const SLOT_EXEC := 0
const SLOT_DATA := 1

var plugin: EditorPlugin

var _client: CompanionClient
var _project: Dictionary = {}
var _file_path := ""
var _function_id := ""
var _dirty := false
var _busy := false
## node id -> { "in": [port ids in slot order], "out": [...] }
var _ports: Dictionary = {}
var _palette: Array = []
var _pending_add_position := Vector2.ZERO

var _status: Label
var _script_select: OptionButton
var _function_select: OptionButton
var _graph: GraphEdit
var _diagnostics: ItemList
var _open_dialog: EditorFileDialog
var _save_dialog: EditorFileDialog
var _add_popup: PopupPanel
var _add_search: LineEdit
var _add_list: ItemList
var _confirm: ConfirmationDialog


func _ready() -> void:
	size_flags_vertical = Control.SIZE_EXPAND_FILL
	_client = CompanionClient.new()
	add_child(_client)
	_build_ui()
	_set_status("Open or create a visual script (.vproj.json). Requires the companion: npm run companion")


# ---------------------------------------------------------------------------
# UI construction
# ---------------------------------------------------------------------------

func _build_ui() -> void:
	var bar := HBoxContainer.new()
	add_child(bar)
	_add_button(bar, "New", _on_new)
	_add_button(bar, "Open…", func() -> void: _open_dialog.popup_centered_ratio(0.6))
	_add_button(bar, "Save", _on_save)
	bar.add_child(VSeparator.new())
	_script_select = OptionButton.new()
	_script_select.tooltip_text = "Script"
	_script_select.item_selected.connect(_on_script_selected)
	bar.add_child(_script_select)
	_function_select = OptionButton.new()
	_function_select.tooltip_text = "Function / event graph"
	_function_select.item_selected.connect(_on_function_selected)
	bar.add_child(_function_select)
	bar.add_child(VSeparator.new())
	_add_button(bar, "Add Node", func() -> void: _show_add_popup(_graph.size / 2.0))
	_add_button(bar, "Generate .gd", _on_generate)
	_add_button(bar, "Attach to Selected Node", _on_attach)
	_add_button(bar, "Refresh", _on_refresh)
	_status = Label.new()
	_status.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_status.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	_status.clip_text = true
	bar.add_child(_status)

	var split := VSplitContainer.new()
	split.size_flags_vertical = Control.SIZE_EXPAND_FILL
	add_child(split)
	_graph = GraphEdit.new()
	_graph.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_graph.right_disconnects = true
	_graph.connection_request.connect(_on_connection_request)
	_graph.disconnection_request.connect(_on_disconnection_request)
	_graph.delete_nodes_request.connect(_on_delete_nodes_request)
	_graph.end_node_move.connect(_on_end_node_move)
	_graph.popup_request.connect(_show_add_popup)
	split.add_child(_graph)
	_diagnostics = ItemList.new()
	_diagnostics.custom_minimum_size = Vector2(0, 110)
	_diagnostics.item_activated.connect(_on_diagnostic_activated)
	_diagnostics.item_selected.connect(_on_diagnostic_activated)
	split.add_child(_diagnostics)

	_open_dialog = EditorFileDialog.new()
	_open_dialog.file_mode = EditorFileDialog.FILE_MODE_OPEN_FILE
	_open_dialog.access = EditorFileDialog.ACCESS_RESOURCES
	_open_dialog.add_filter("*.vproj.json", "Coding Studio project")
	_open_dialog.file_selected.connect(_load_file)
	add_child(_open_dialog)
	_save_dialog = EditorFileDialog.new()
	_save_dialog.file_mode = EditorFileDialog.FILE_MODE_SAVE_FILE
	_save_dialog.access = EditorFileDialog.ACCESS_RESOURCES
	_save_dialog.add_filter("*.vproj.json", "Coding Studio project")
	_save_dialog.file_selected.connect(_save_to)
	add_child(_save_dialog)

	_add_popup = PopupPanel.new()
	var box := VBoxContainer.new()
	box.custom_minimum_size = Vector2(320, 380)
	_add_popup.add_child(box)
	_add_search = LineEdit.new()
	_add_search.placeholder_text = "Search nodes…"
	_add_search.text_changed.connect(func(_t: String) -> void: _fill_palette())
	_add_search.text_submitted.connect(func(_t: String) -> void: _choose_palette(0))
	box.add_child(_add_search)
	_add_list = ItemList.new()
	_add_list.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_add_list.item_activated.connect(_choose_palette)
	box.add_child(_add_list)
	add_child(_add_popup)

	_confirm = ConfirmationDialog.new()
	add_child(_confirm)


func _add_button(parent: Control, label: String, cb: Callable) -> Button:
	var b := Button.new()
	b.text = label
	b.flat = true
	b.pressed.connect(cb)
	parent.add_child(b)
	return b


func _set_status(text: String, is_error := false) -> void:
	if _status:
		_status.text = text
		_status.modulate = Color(1, 0.55, 0.55) if is_error else Color(1, 1, 1, 0.75)


# ---------------------------------------------------------------------------
# File handling
# ---------------------------------------------------------------------------

func _on_new() -> void:
	var r: Dictionary = await _client.post_json("/new", {"name": "Visual Script", "template": "node", "scriptName": "Main"})
	if not r.ok:
		_report(r.error)
		return
	_project = r.data.project
	_file_path = ""
	_dirty = true
	_select_first_function()
	await _redraw()
	_save_dialog.popup_centered_ratio(0.6)


func _load_file(path: String) -> void:
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		_set_status("Cannot open %s (%s)" % [path, error_string(FileAccess.get_open_error())], true)
		return
	var parsed: Variant = JSON.parse_string(f.get_as_text())
	if not (parsed is Dictionary):
		_set_status("%s is not a Coding Studio project" % path, true)
		return
	_project = parsed
	_file_path = path
	_dirty = false
	_select_first_function()
	await _redraw()
	await _compile_and_show()


func _on_save() -> void:
	if _project.is_empty():
		return
	if _file_path == "":
		_save_dialog.popup_centered_ratio(0.6)
	else:
		_save_to(_file_path)


func _save_to(path: String) -> void:
	if not path.ends_with(".vproj.json"):
		path = path.get_basename() + ".vproj.json"
	var f := FileAccess.open(path, FileAccess.WRITE)
	if f == null:
		_set_status("Cannot write %s (%s)" % [path, error_string(FileAccess.get_open_error())], true)
		return
	f.store_string(JSON.stringify(_project, "  ") + "\n")
	f.close()
	_file_path = path
	_dirty = false
	plugin.get_editor_interface().get_resource_filesystem().update_file(path)
	_set_status("Saved %s" % path)


# ---------------------------------------------------------------------------
# Script / function selection
# ---------------------------------------------------------------------------

func _scripts() -> Array:
	return _project.get("scripts", [])


func _active_script() -> Dictionary:
	for s: Dictionary in _scripts():
		for f: Dictionary in s.get("functions", []):
			if f.get("id", "") == _function_id:
				return s
	var all := _scripts()
	return all[0] if all.size() > 0 else {}


func _select_first_function() -> void:
	var editor_state: Dictionary = _project.get("editor", {})
	_function_id = editor_state.get("activeFunctionId", "")
	if _active_script().is_empty():
		_function_id = ""
	var s := _active_script()
	if _function_id == "" and not s.is_empty() and s.functions.size() > 0:
		_function_id = s.functions[0].id


func _fill_selectors() -> void:
	_script_select.clear()
	_function_select.clear()
	var active := _active_script()
	var i := 0
	for s: Dictionary in _scripts():
		_script_select.add_item(s.name)
		_script_select.set_item_metadata(i, s.id)
		if s.id == active.get("id", ""):
			_script_select.select(i)
		i += 1
	i = 0
	for f: Dictionary in active.get("functions", []):
		_function_select.add_item(("⚡ " if f.kind == "event" else "ƒ ") + f.name)
		_function_select.set_item_metadata(i, f.id)
		if f.id == _function_id:
			_function_select.select(i)
		i += 1


func _on_script_selected(index: int) -> void:
	var id: String = _script_select.get_item_metadata(index)
	for s: Dictionary in _scripts():
		if s.id == id and s.functions.size() > 0:
			_function_id = s.functions[0].id
	await _redraw()


func _on_function_selected(index: int) -> void:
	_function_id = _function_select.get_item_metadata(index)
	await _redraw()


# ---------------------------------------------------------------------------
# Drawing the graph
# ---------------------------------------------------------------------------

func _redraw() -> void:
	_fill_selectors()
	for c in _graph.get_children():
		if c is GraphNode:
			_graph.remove_child(c)
			c.queue_free()
	_graph.clear_connections()
	_ports.clear()
	if _project.is_empty() or _function_id == "":
		return
	var r: Dictionary = await _client.post_json("/describe", {"project": _project, "function": _function_id})
	if not r.ok:
		_report(r.error)
		return
	for n: Dictionary in r.data.nodes:
		_graph.add_child(_make_node(n))
	for e: Dictionary in r.data.edges:
		var a: Dictionary = _ports.get(e.from.node, {})
		var b: Dictionary = _ports.get(e.to.node, {})
		if a.is_empty() or b.is_empty():
			continue
		var fi: int = (a.out as Array).find(e.from.port)
		var ti: int = (b["in"] as Array).find(e.to.port)
		if fi >= 0 and ti >= 0:
			_graph.connect_node(e.from.node, fi, e.to.node, ti)


func _make_node(n: Dictionary) -> GraphNode:
	var gn := GraphNode.new()
	gn.name = n.id
	gn.title = n.title
	gn.position_offset = Vector2(n.position.x, n.position.y)
	gn.tooltip_text = "%s (%s)" % [n.type, n.category]
	var inputs: Array = n.inputs
	var outputs: Array = n.outputs
	var in_ids: Array = []
	var out_ids: Array = []
	var rows: int = max(inputs.size(), outputs.size(), 1)
	for i in rows:
		var row := HBoxContainer.new()
		var left := Label.new()
		var right := Label.new()
		right.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		right.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		row.add_child(left)
		if i < inputs.size():
			var p: Dictionary = inputs[i]
			left.text = p.name
			if p.editable != null and not p.connected:
				row.add_child(_make_value_editor(n, p))
		row.add_child(right)
		if i < outputs.size():
			right.text = outputs[i].name
		gn.add_child(row)
		var has_in := i < inputs.size()
		var has_out := i < outputs.size()
		var in_kind := SLOT_EXEC if has_in and inputs[i].kind == "exec" else SLOT_DATA
		var out_kind := SLOT_EXEC if has_out and outputs[i].kind == "exec" else SLOT_DATA
		var in_color := Color.from_string(inputs[i].color, Color.WHITE) if has_in else Color.WHITE
		var out_color := Color.from_string(outputs[i].color, Color.WHITE) if has_out else Color.WHITE
		gn.set_slot(i, has_in, in_kind, in_color, has_out, out_kind, out_color)
		if has_in:
			in_ids.append(inputs[i].id)
		if has_out:
			out_ids.append(outputs[i].id)
	_ports[n.id] = {"in": in_ids, "out": out_ids}
	return gn


func _make_value_editor(n: Dictionary, p: Dictionary) -> Control:
	var values: Dictionary = n.get("values", {})
	var current: Variant = values.get(p.id, p.get("default", null))
	if p.editable == "bool":
		var cb := CheckBox.new()
		cb.button_pressed = current == true
		cb.toggled.connect(func(on: bool) -> void: _apply([{"op": "update_node", "node": n.id, "inputs": {p.id: on}}]))
		return cb
	var le := LineEdit.new()
	le.custom_minimum_size = Vector2(70, 0)
	le.text = "" if current == null else str(current)
	le.text_submitted.connect(func(t: String) -> void: _commit_value(n.id, p, t))
	le.focus_exited.connect(func() -> void: _commit_value(n.id, p, le.text))
	return le


func _commit_value(node_id: String, p: Dictionary, t: String) -> void:
	var value: Variant = t
	match p.editable:
		"int":
			if not t.is_valid_int():
				_set_status("%s must be an integer" % p.name, true)
				return
			value = t.to_int()
		"float":
			if not t.is_valid_float():
				_set_status("%s must be a number" % p.name, true)
				return
			value = t.to_float()
	await _apply([{"op": "update_node", "node": node_id, "inputs": {p.id: value}}])


# ---------------------------------------------------------------------------
# Edits → companion /apply (atomic, validated) → redraw
# ---------------------------------------------------------------------------

func _apply(operations: Array) -> bool:
	if _busy or _project.is_empty():
		return false
	_busy = true
	var s := _active_script()
	var r: Dictionary = await _client.post_json("/apply", {"project": _project, "operations": operations, "defaults": {"scriptId": s.get("id", ""), "functionId": _function_id}})
	_busy = false
	if not r.ok:
		_report(r.error)
		await _redraw()
		return false
	_project = r.data.project
	_dirty = true
	for w: String in r.data.warnings:
		push_warning("Coding Studio: " + w)
	await _redraw()
	await _compile_and_show()
	return true


func _port_id(node_name: StringName, side: String, index: int) -> String:
	var p: Dictionary = _ports.get(String(node_name), {})
	var list: Array = p.get(side, [])
	return list[index] if index >= 0 and index < list.size() else ""


func _on_connection_request(from_node: StringName, from_port: int, to_node: StringName, to_port: int) -> void:
	await _apply([{"op": "connect", "from": {"node": String(from_node), "port": _port_id(from_node, "out", from_port)}, "to": {"node": String(to_node), "port": _port_id(to_node, "in", to_port)}}])


func _on_disconnection_request(from_node: StringName, from_port: int, to_node: StringName, to_port: int) -> void:
	await _apply([{"op": "disconnect", "from": {"node": String(from_node), "port": _port_id(from_node, "out", from_port)}, "to": {"node": String(to_node), "port": _port_id(to_node, "in", to_port)}}])


func _on_delete_nodes_request(names: Array) -> void:
	var ids: Array = []
	for nm in names:
		ids.append(String(nm))
	if ids.size() > 0:
		await _apply([{"op": "delete_nodes", "nodes": ids}])


func _on_end_node_move() -> void:
	var positions := {}
	var ids: Array = []
	for c in _graph.get_children():
		if c is GraphNode and c.selected:
			ids.append(String(c.name))
			positions[String(c.name)] = {"x": roundi(c.position_offset.x), "y": roundi(c.position_offset.y)}
	if ids.size() > 0:
		await _apply([{"op": "move_nodes", "nodes": ids, "positions": positions}])


# ---------------------------------------------------------------------------
# Add node popup
# ---------------------------------------------------------------------------

func _show_add_popup(at_position: Vector2) -> void:
	if _project.is_empty():
		return
	_pending_add_position = (at_position + _graph.scroll_offset) / _graph.zoom
	if _palette.is_empty():
		var r: Dictionary = await _client.get_json("/palette?language=" + str(_project.get("language", "gdscript")))
		if not r.ok:
			_report(r.error)
			return
		_palette = r.data
	_add_search.text = ""
	_fill_palette()
	_add_popup.popup(Rect2i(Vector2i(get_screen_position() + _graph.position + at_position), Vector2i(320, 380)))
	_add_search.grab_focus()


func _fill_palette() -> void:
	_add_list.clear()
	var q := _add_search.text.to_lower()
	for entry: Dictionary in _palette:
		var hay := ("%s %s %s" % [entry.title, entry.category, entry.type]).to_lower()
		if q == "" or Array(q.split(" ", false)).all(func(w: String) -> bool: return hay.contains(w)):
			var i := _add_list.add_item("%s   — %s" % [entry.title, entry.category])
			_add_list.set_item_metadata(i, entry.type)
			_add_list.set_item_tooltip(i, entry.description)
		if _add_list.item_count >= 200:
			break


func _choose_palette(index: int) -> void:
	if index < 0 or index >= _add_list.item_count:
		return
	var type: String = _add_list.get_item_metadata(index)
	_add_popup.hide()
	await _apply([{"op": "add_node", "type": type, "position": {"x": roundi(_pending_add_position.x), "y": roundi(_pending_add_position.y)}}])


# ---------------------------------------------------------------------------
# Compile, generate, attach
# ---------------------------------------------------------------------------

func _compile_and_show() -> Dictionary:
	_diagnostics.clear()
	if _project.is_empty():
		return {}
	var r: Dictionary = await _client.post_json("/compile", {"project": _project})
	if not r.ok:
		_report(r.error)
		return {}
	for d: Dictionary in r.data.diagnostics:
		var icon := "✖ " if d.severity == "error" else ("⚠ " if d.severity == "warning" else "ℹ ")
		var i := _diagnostics.add_item(icon + d.message)
		_diagnostics.set_item_metadata(i, d)
		if d.severity == "error":
			_diagnostics.set_item_custom_fg_color(i, Color(1, 0.55, 0.55))
	var errors := 0
	for d: Dictionary in r.data.diagnostics:
		if d.severity == "error":
			errors += 1
	_set_status(("%d error(s) — no code generated" % errors) if errors > 0 else "Compiles cleanly", errors > 0)
	return r.data


func _output_dir() -> String:
	return _file_path.get_base_dir() if _file_path != "" else "res://"


func _on_generate() -> void:
	if _project.is_empty():
		return
	if _file_path == "":
		_set_status("Save the project first: generated scripts are written next to it.", true)
		return
	var data := await _compile_and_show()
	if data.is_empty() or not data.ok:
		return
	var foreign: Array = []
	for file: Dictionary in data.files:
		var target := _output_dir().path_join(file.path)
		if FileAccess.file_exists(target):
			var existing := FileAccess.get_file_as_string(target)
			if not existing.begins_with(GENERATED_HEADER):
				foreign.append(target)
	if foreign.size() > 0:
		_confirm.dialog_text = "These files exist and were not generated by Coding Studio:\n%s\n\nOverwrite them?" % "\n".join(foreign)
		_confirm.popup_centered()
		var approved: bool = await _await_confirm()
		if not approved:
			_set_status("Generation cancelled; no files were changed.")
			return
	var written: Array = []
	for file: Dictionary in data.files:
		var target := _output_dir().path_join(file.path)
		DirAccess.make_dir_recursive_absolute(target.get_base_dir())
		var f := FileAccess.open(target, FileAccess.WRITE)
		if f == null:
			_set_status("Cannot write %s" % target, true)
			return
		f.store_string(file.content)
		f.close()
		written.append(target)
	var fs := plugin.get_editor_interface().get_resource_filesystem()
	for path: String in written:
		fs.update_file(path)
		if ResourceLoader.has_cached(path):
			var script := load(path) as Script
			if script:
				script.source_code = FileAccess.get_file_as_string(path)
				script.reload(true)
	_set_status("Generated %d script(s): %s" % [written.size(), ", ".join(written)])


func _await_confirm() -> bool:
	var result := [false]
	var on_ok := func() -> void: result[0] = true
	_confirm.confirmed.connect(on_ok, CONNECT_ONE_SHOT)
	await _confirm.visibility_changed
	while _confirm.visible:
		await get_tree().process_frame
	if _confirm.confirmed.is_connected(on_ok):
		_confirm.confirmed.disconnect(on_ok)
	return result[0]


func _on_refresh() -> void:
	if _file_path != "":
		await _load_file(_file_path)
		await _on_generate()


func _on_attach() -> void:
	var s := _active_script()
	if s.is_empty() or _file_path == "":
		_set_status("Open a saved project and generate it first.", true)
		return
	var path := _output_dir().path_join(str(s.path) + ".gd")
	if not FileAccess.file_exists(path):
		await _on_generate()
	if not FileAccess.file_exists(path):
		return
	var script := load(path) as Script
	var nodes: Array = plugin.get_editor_interface().get_selection().get_selected_nodes()
	if nodes.is_empty():
		_set_status("Select a node in the scene tree first.", true)
		return
	var ur := plugin.get_undo_redo()
	ur.create_action("Attach generated script")
	for node: Node in nodes:
		ur.add_do_method(node, "set_script", script)
		ur.add_undo_method(node, "set_script", node.get_script())
	ur.commit_action()
	_set_status("Attached %s to %d node(s)" % [path, nodes.size()])


# ---------------------------------------------------------------------------
# Diagnostics → graph
# ---------------------------------------------------------------------------

func _on_diagnostic_activated(index: int) -> void:
	var d: Dictionary = _diagnostics.get_item_metadata(index)
	var fn_id: String = d.get("functionId", "")
	if fn_id != "" and fn_id != _function_id:
		_function_id = fn_id
		await _redraw()
	var node_id: String = d.get("nodeId", "")
	if node_id == "" or not _graph.has_node(NodePath(node_id)):
		return
	var gn := _graph.get_node(NodePath(node_id)) as GraphNode
	for c in _graph.get_children():
		if c is GraphNode:
			c.selected = c == gn
	_graph.scroll_offset = gn.position_offset * _graph.zoom - _graph.size / 2.0


func _report(error: Variant) -> void:
	var msg := "Unknown error"
	if error is Dictionary:
		msg = "%s: %s" % [error.get("code", "E"), error.get("message", "")]
	_set_status(msg, true)
	push_error("Coding Studio: " + msg)
