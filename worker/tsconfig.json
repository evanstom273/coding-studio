{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "@cs/type-system": [
        "packages/type-system/src/index.ts"
      ],
      "@cs/graph-core": [
        "packages/graph-core/src/index.ts"
      ],
      "@cs/intermediate-representation": [
        "packages/intermediate-representation/src/index.ts"
      ],
      "@cs/node-registry": [
        "packages/node-registry/src/index.ts"
      ],
      "@cs/node-registry/core-nodes": [
        "packages/node-registry/src/core-nodes.ts"
      ],
      "@cs/language-sdk": [
        "packages/language-sdk/src/index.ts"
      ],
      "@cs/compiler-core": [
        "packages/compiler-core/src/index.ts"
      ],
      "@cs/language-gdscript": [
        "packages/language-gdscript/src/index.ts"
      ],
      "@cs/toolchain": [
        "packages/toolchain/src/index.ts"
      ],
      "@cs/project-format": [
        "packages/project-format/src/index.ts"
      ],
      "@cs/shared-protocol": [
        "packages/shared-protocol/src/index.ts"
      ],
      "@cs/examples": [
        "packages/examples/src/index.ts"
      ],
      "@cs/project-service": [
        "packages/project-service/src/index.ts"
      ]
    }
  },
  "include": [
    "./*.ts"
  ]
}
