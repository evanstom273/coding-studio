{
  "name": "coding-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Universal visual programming IDE: Blueprint-style graphs compiled to readable source code (GDScript first).",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "test:godot": "node scripts/validate-godot.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:companion": "esbuild mcp/companion/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/companion/coding-studio-companion.mjs --log-level=warning",
    "mcp": "node dist/mcp/coding-studio-mcp.mjs",
    "companion": "node dist/companion/coding-studio-companion.mjs",
    "examples:export": "vitest run tests/compiler/examples.test.ts",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.10.0",
    "dexie": "^4.4.7",
    "esbuild-wasm": "^0.28.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.66.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.158.0"
  }
}
