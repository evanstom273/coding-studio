# Generated by Coding Studio from the visual script "FirstPersonLook".
# Edit the graph in Coding Studio; changes made here are overwritten on the next export.
extends CharacterBody3D
## Expects a child Node3D called "Head" holding the Camera3D.

## Radians per pixel of mouse movement.
@export var sensitivity: float = 0.003

@onready var head: Node3D = $Head


func _ready() -> void:
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseMotion:
		rotate_y(-((event as InputEventMouseMotion).relative.x * sensitivity))
		head.rotate_x(-((event as InputEventMouseMotion).relative.y * sensitivity))
		head.rotation = Vector3(clampf(head.rotation.x, deg_to_rad(-89.0), deg_to_rad(89.0)), head.rotation.y, head.rotation.z)
	if event.is_action_pressed("ui_cancel"):
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
