extends CharacterBody3D
## Walks on the ground relative to where it faces.

@export var speed: float = 5.0
@export var gravity: float = 9.8


func _physics_process(delta: float) -> void:
	var input_dir: Vector2
	var direction: Vector3
	if not is_on_floor():
		velocity = velocity - Vector3(0.0, gravity * delta, 0.0)
	input_dir = Input.get_vector("ui_left", "ui_right", "ui_up", "ui_down")
	direction = (basis * Vector3(input_dir.x, 0.0, input_dir.y)).normalized()
	velocity = Vector3(direction.x * speed, velocity.y, direction.z * speed)
	move_and_slide()
