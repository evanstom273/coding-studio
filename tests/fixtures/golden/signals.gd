# Generated by Coding Studio from the visual script "Health".
# Edit the graph in Coding Studio; changes made here are overwritten on the next export.
extends Node
## A health component that announces changes with signals.

## Emitted after damage is taken.
signal health_changed(new_health: int)
signal died

var health: int = 100


func _ready() -> void:
	connect("health_changed", _on_health_changed)
	take_damage(30)
	take_damage(80)


func _on_health_changed(new_health: int) -> void:
	print("Health: " + str(new_health))


## Reduce health and notify listeners.
func take_damage(amount: int) -> void:
	health -= amount
	health_changed.emit(health)
	if health <= 0:
		died.emit()
