# Edit the graph in Coding Studio; changes made here are overwritten on the next export.
extends Node
## Keeps a score and does some arithmetic with it.

const MAX_SCORE: int = 100

@export var multiplier: float = 1.5

## Points collected so far.
var score: int = 0


func _ready() -> void:
	score += 10
	score *= 3
	print("Score: " + str(score))
	print("Weighted: " + str(score * multiplier))
	print(mini(score, MAX_SCORE))
