## Demonstrates the three loop kinds.


func _ready() -> void:
	var countdown: int = 3
	for i in range(1, 6):
		print(str(i * i))
	for item in ["sword", "shield", "potion"]:
		print("Item: " + item)
	while countdown > 0:
		print(str(countdown))
		countdown -= 1
	print("Liftoff!")
