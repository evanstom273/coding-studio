# Edit the graph in Coding Studio; changes made here are overwritten on the next export.
extends Node
## Ticks five times, then stops.

@export var interval: float = 1.0

var ticks: int = 0
var timer: Timer


func _ready() -> void:
	print("Starting in half a second…")
	await get_tree().create_timer(0.5).timeout
	var new_timer: Timer = Timer.new()
	timer = new_timer
	timer.wait_time = interval
	timer.connect("timeout", _on_timer_timeout)
	add_child(timer)
	timer.start(-1.0)


func _on_timer_timeout() -> void:
	ticks += 1
	print("Tick " + str(ticks))
	if ticks >= 5:
		timer.stop()
		print("Timer finished")
